<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_1E86FC"
    android:orientation="vertical">

    <include layout="@layout/include_blue_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/font_dimen_10"
        android:layout_marginTop="@dimen/font_dimen_10"
        android:layout_marginRight="@dimen/font_dimen_10"
        android:background="@drawable/bg_google_picture_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/font_dimen_30"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/font_dimen_15"
                android:layout_marginRight="@dimen/font_dimen_15"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/font_dimen_18"
                        android:layout_height="@dimen/font_dimen_18"
                        android:src="@drawable/google_yes" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upload"
                        android:textColor="@color/color_1E86FC"
                        android:textSize="@dimen/font_sp_12" />
                </LinearLayout>

                <TextView
                    android:layout_width="0dip"
                    android:layout_height="@dimen/font_dimen_1"
                    android:layout_marginLeft="@dimen/font_dimen_10"
                    android:layout_marginTop="@dimen/font_dimen_8"
                    android:layout_marginRight="@dimen/font_dimen_10"
                    android:layout_weight="1"
                    android:background="@color/color_1E86FC" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/font_dimen_18"
                        android:layout_height="@dimen/font_dimen_18"
                        android:src="@drawable/google_yes" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/comfirm"
                        android:textColor="@color/color_1E86FC"
                        android:textSize="@dimen/font_sp_12" />
                </LinearLayout>

                <TextView
                    android:layout_width="0dip"
                    android:layout_height="@dimen/font_dimen_1"
                    android:layout_marginLeft="@dimen/font_dimen_10"
                    android:layout_marginTop="@dimen/font_dimen_8"
                    android:layout_marginRight="@dimen/font_dimen_10"
                    android:layout_weight="1"
                    android:background="@color/color_1E86FC" />


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/font_dimen_18"
                        android:layout_height="@dimen/font_dimen_18"
                        android:src="@drawable/google_yes" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audit"
                        android:textColor="@color/color_1E86FC"
                        android:textSize="@dimen/font_sp_12" />
                </LinearLayout>

                <TextView
                    android:layout_width="0dip"
                    android:layout_height="@dimen/font_dimen_1"
                    android:layout_marginLeft="@dimen/font_dimen_10"
                    android:layout_marginTop="@dimen/font_dimen_8"
                    android:layout_marginRight="@dimen/font_dimen_10"
                    android:layout_weight="1"
                    android:background="@color/color_1E86FC" />


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/img_top_picture"
                        android:layout_width="@dimen/font_dimen_18"
                        android:layout_height="@dimen/font_dimen_18"
                        android:src="@drawable/google_no" />

                    <TextView
                        android:id="@+id/tv_top_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/complete"
                        android:textColor="@color/color_b2b2b2"
                        android:textSize="@dimen/font_sp_12" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/font_dimen_30">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/font_dimen_18"
                android:layout_marginTop="@dimen/font_dimen_20"
                android:layout_marginRight="@dimen/font_dimen_18"
                android:paddingBottom="@dimen/font_dimen_20"
                android:background="@drawable/bg_google_picture_radio_bg"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/font_dimen_19"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/font_dimen_35"
                        android:text="@string/authentication_message"
                        android:textColor="@color/color_303030"
                        android:textSize="@dimen/font_sp_13" />

                    <TextView
                        android:id="@+id/tv_familyName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/font_dimen_16"
                        android:textColor="@color/color_303030"
                        android:textSize="@dimen/font_sp_13" />

                    <TextView
                        android:id="@+id/tv_idNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="@dimen/font_dimen_20"
                        android:layout_marginTop="@dimen/font_dimen_14"
                        android:textColor="@color/color_303030"
                        android:textSize="@dimen/font_sp_13" />


                    <TextView
                        android:id="@+id/tv_rejectReason"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/font_dimen_12"
                        android:textColor="@color/color_FF3350"
                        android:textSize="@dimen/font_sp_13"
                        android:visibility="gone"/>
                </LinearLayout>
            </RelativeLayout>

            <ImageView
                android:id="@+id/img_picture"
                android:layout_width="@dimen/font_dimen_74"
                android:layout_height="@dimen/font_dimen_66"
                android:layout_alignParentRight="true"
                android:layout_gravity="center"
                android:layout_marginRight="@dimen/font_dimen_10"
                android:src="@drawable/authencation_review" />
        </RelativeLayout>


        <Button
            android:id="@+id/bt_next"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/font_dimen_49"
            android:layout_marginLeft="@dimen/font_dimen_62"
            android:layout_marginTop="@dimen/font_dimen_63"
            android:layout_marginRight="@dimen/font_dimen_62"
            android:layout_marginBottom="@dimen/font_dimen_20"
            android:background="@drawable/btn_selector"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="@string/info_cxrz"
            android:textColor="@color/white"
            android:textSize="@dimen/font_sp_14"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
