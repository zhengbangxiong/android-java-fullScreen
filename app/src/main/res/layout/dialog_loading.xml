<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_loading_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="@dimen/font_dimen_150"
        android:layout_height="@dimen/font_dimen_110"
        android:background="@drawable/loading_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="@dimen/font_dimen_10"
        android:paddingLeft="@dimen/font_dimen_21"
        android:paddingRight="@dimen/font_dimen_21"
        android:paddingTop="@dimen/font_dimen_10">

        <ProgressBar
            android:id="@+id/progressBar1"
            android:layout_width="@dimen/font_dimen_35"
            android:layout_height="@dimen/font_dimen_35"
            android:layout_gravity="center_horizontal"
            android:indeterminateBehavior="repeat"
            android:indeterminateDrawable="@drawable/dialog_loading"
            android:indeterminateOnly="true" />

        <TextView
            android:id="@+id/tipTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/font_dimen_15"
            android:text="@string/dialog_loading"
            android:textColor="@color/color_f0f0f0"
            android:textSize="@dimen/font_sp_15" />
    </LinearLayout>

</LinearLayout>