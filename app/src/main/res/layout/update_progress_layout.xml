<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@+id/llt_upload"
    android:layout_width="311dp"
    android:layout_height="499dp"
    android:layout_centerInParent="true"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <RelativeLayout
        android:layout_width="311dp"
        android:layout_height="369dp"
        android:layout_centerInParent="true"
        android:background="@drawable/dialog_upload">

        <TextView
            android:id="@+id/tv_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/font_dimen_50"
            android:layout_marginTop="48dp"
            android:text="@string/dialog_update_version"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_key"
            android:layout_marginLeft="@dimen/font_dimen_50"
            android:text="V1.0"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="83dip"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/font_dimen_45"
                    android:layout_marginTop="@dimen/font_dimen_160"
                    android:layout_marginRight="@dimen/font_dimen_45"
                    android:lineSpacingExtra="@dimen/font_dimen_10"
                    android:text=""
                    android:textColor="@color/color_5a5a5a"
                    android:textSize="14sp" />

            </LinearLayout>
        </ScrollView>


        <LinearLayout
            android:id="@+id/llt_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/font_dimen_40"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <app.gkai.ai.core.common.view.NumberProgressBar
                android:id="@+id/number_progress"
                android:layout_width="200dp"
                android:layout_height="150dp" />

            <TextView
                android:id="@+id/update_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginTop="@dimen/font_dimen_10"
                android:text="@string/dialog_version_loading"
                android:textColor="@color/color_5a5a5a"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/bt_next"
            android:layout_width="@dimen/font_dimen_200"
            android:layout_height="@dimen/font_dimen_44"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/font_dimen_50"
            android:background="@drawable/btn_matchine_buy"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="@string/dialog_ljgx"
            android:textColor="@color/white"
            android:textSize="@dimen/font_sp_15" />

        <TextView
            android:id="@+id/problem_text"
            android:layout_width="311dp"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/font_dimen_25"
            android:gravity="center"
            android:text="@string/upload_problem"
            android:textColor="@color/color_1E86FC"
            android:textSize="@dimen/font_sp_12"
            android:visibility="gone"/>



    </RelativeLayout>

    <TextView
        android:id="@+id/problem_bg"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:background="#55000000"
        android:gravity="center"
        android:text="@string/upload_problem2"
        android:textColor="#ffffff"
        android:textSize="@dimen/font_sp_12"
        android:paddingLeft="5dip"
        android:paddingRight="5dip"
        android:paddingTop="5dip"
        android:paddingBottom="5dip"
        android:layout_marginTop="415dip"
        android:layout_centerHorizontal="true"
        android:visibility="gone"
        />
</RelativeLayout>