<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_f2f2f2"
    android:orientation="vertical">

    <include layout="@layout/include_white_title"></include>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/font_dimen_10"
            android:layout_marginTop="@dimen/font_dimen_10"
            android:layout_marginRight="@dimen/font_dimen_10"
            android:orientation="vertical">

        <LinearLayout
            android:id="@+id/llt_center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/promote_bg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/font_dimen_82"
                android:background="@drawable/bg_promote_radius"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/font_dimen_23"
                        android:layout_marginTop="@dimen/font_dimen_10"
                        android:orientation="vertical"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/img_head"
                                android:layout_width="@dimen/font_dimen_24"
                                android:layout_height="@dimen/font_dimen_24"
                                android:background="@drawable/headimg_one" />

                            <TextView
                                android:id="@+id/tv_mail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textColor="#ff303030"
                                android:paddingLeft="@dimen/font_dimen_5"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/font_dimen_5"
                            android:text="@string/yqm"
                            android:textColor="#ff303030"
                            android:textSize="10sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_yqm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textColor="#303030"
                                android:textSize="15sp" />
                            <TextView
                                android:id="@+id/tv_copy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="@string/copy"
                                android:textColor="#228EFF"
                                android:padding="@dimen/font_dimen_5"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/img_ewm"
                        android:layout_width="@dimen/font_dimen_60"
                        android:layout_height="@dimen/font_dimen_60"
                        android:layout_marginTop="@dimen/font_dimen_10"
                        android:layout_marginRight="@dimen/font_dimen_17" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


            <Button
                android:id="@+id/bt_next"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/font_dimen_44"
                android:layout_marginTop="@dimen/font_dimen_20"
                android:layout_marginBottom="@dimen/font_dimen_20"
                android:background="@drawable/btn_share_selector"
                android:gravity="center"
                android:stateListAnimator="@null"
                android:text="@string/sharePicture"
                android:textColor="@color/white"
                android:textSize="@dimen/font_sp_14" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>