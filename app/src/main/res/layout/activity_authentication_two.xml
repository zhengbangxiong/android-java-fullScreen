<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_1E86FC"
    android:orientation="vertical">

    <include layout="@layout/include_blue_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/font_dimen_10"
                android:layout_marginTop="@dimen/font_dimen_10"
                android:layout_marginRight="@dimen/font_dimen_10"
                android:background="@drawable/bg_google_picture_bg"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/font_dimen_15"
                    android:layout_marginTop="@dimen/font_dimen_35"
                    android:layout_marginRight="@dimen/font_dimen_15"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/font_dimen_18"
                            android:layout_height="@dimen/font_dimen_18"
                            android:src="@drawable/google_yes" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/upload"
                            android:textColor="@color/color_1E86FC"
                            android:textSize="@dimen/font_sp_12" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="0dip"
                        android:layout_height="@dimen/font_dimen_1"
                        android:layout_marginLeft="@dimen/font_dimen_10"
                        android:layout_marginTop="@dimen/font_dimen_8"
                        android:layout_marginRight="@dimen/font_dimen_10"
                        android:layout_weight="1"
                        android:background="@color/color_1E86FC" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/font_dimen_18"
                            android:layout_height="@dimen/font_dimen_18"
                            android:src="@drawable/google_no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/comfirm"
                            android:textColor="@color/color_b2b2b2"
                            android:textSize="@dimen/font_sp_12" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="0dip"
                        android:layout_height="@dimen/font_dimen_1"
                        android:layout_marginLeft="@dimen/font_dimen_10"
                        android:layout_marginTop="@dimen/font_dimen_8"
                        android:layout_marginRight="@dimen/font_dimen_10"
                        android:layout_weight="1"
                        android:background="@color/color_f0f0f0" />


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/font_dimen_18"
                            android:layout_height="@dimen/font_dimen_18"
                            android:src="@drawable/google_no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/audit"
                            android:textColor="@color/color_b2b2b2"
                            android:textSize="@dimen/font_sp_12" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="0dip"
                        android:layout_height="@dimen/font_dimen_1"
                        android:layout_marginLeft="@dimen/font_dimen_10"
                        android:layout_marginTop="@dimen/font_dimen_8"
                        android:layout_marginRight="@dimen/font_dimen_10"
                        android:layout_weight="1"
                        android:background="@color/color_f0f0f0" />


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/font_dimen_18"
                            android:layout_height="@dimen/font_dimen_18"
                            android:src="@drawable/google_no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/complete"
                            android:textColor="@color/color_b2b2b2"
                            android:textSize="@dimen/font_sp_12" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/font_dimen_15"
                    android:layout_marginRight="@dimen/font_dimen_15"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">


                    <LinearLayout
                        android:id="@+id/rt_bg_one"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/font_dimen_25"
                        android:background="@drawable/bg_google_picture_radio_bg"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/img_front"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/font_dimen_105"
                            android:layout_centerInParent="true"
                            android:layout_marginTop="@dimen/font_dimen_20"
                            android:src="@drawable/authentication_idnumber_front" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="@dimen/font_dimen_14"
                            android:paddingBottom="@dimen/font_dimen_17"
                            android:text="@string/authentication_idnumber_front"
                            android:textColor="@color/color_safely_blue"
                            android:textSize="@dimen/font_sp_12" />
                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/font_dimen_15"
                    android:layout_marginRight="@dimen/font_dimen_15"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">


                    <LinearLayout
                        android:id="@+id/rt_bg_two"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/font_dimen_15"
                        android:background="@drawable/bg_google_picture_radio_bg"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">


                        <ImageView
                            android:id="@+id/img_cont"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/font_dimen_105"
                            android:layout_centerInParent="true"
                            android:layout_marginTop="@dimen/font_dimen_20"
                            android:src="@drawable/authentication_idnumber_cont" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="@dimen/font_dimen_14"
                            android:paddingBottom="@dimen/font_dimen_17"
                            android:text="@string/authentication_idnumber_cont"
                            android:textColor="@color/color_safely_blue"
                            android:textSize="@dimen/font_sp_12" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/font_dimen_15"
                    android:layout_marginRight="@dimen/font_dimen_15"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">


                    <LinearLayout
                        android:id="@+id/rt_bg_three"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/font_dimen_15"
                        android:background="@drawable/bg_google_picture_radio_bg"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/img_sc"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/font_dimen_105"
                            android:layout_marginTop="@dimen/font_dimen_20"
                            android:layout_centerInParent="true"
                            android:src="@drawable/authentication_idnumber_sc" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="@dimen/font_dimen_14"
                            android:paddingBottom="@dimen/font_dimen_17"
                            android:text="@string/authentication_idnumber_sc"
                            android:textColor="@color/color_safely_blue"
                            android:textSize="@dimen/font_sp_12" />
                    </LinearLayout>
                </LinearLayout>



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/font_dimen_15"
                    android:layout_marginRight="@dimen/font_dimen_15"
                    android:layout_marginTop="@dimen/font_dimen_15"
                    android:orientation="vertical"
                    android:background="@drawable/bg_google_picture_red_radio_bg">

                    <TextView
                        android:layout_width="@dimen/font_dimen_60"
                        android:layout_height="@dimen/font_dimen_19"
                        android:text="@string/authentication_idnumber_camera"
                        android:textColor="@color/white"
                        android:textSize="@dimen/font_sp_10"
                        android:gravity="center"
                        android:background="@drawable/google_notice"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/font_dimen_10"
                        android:paddingLeft="@dimen/font_dimen_10"
                        android:text="@string/authentication_idnumber_four"
                        android:textColor="@color/color_F9345D"
                        android:textSize="@dimen/font_sp_12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/font_dimen_10"
                        android:paddingLeft="@dimen/font_dimen_10"
                        android:text="@string/authentication_idnumber_five"
                        android:textColor="@color/color_F9345D"
                        android:textSize="@dimen/font_sp_12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/font_dimen_10"
                        android:paddingLeft="@dimen/font_dimen_10"
                        android:paddingBottom="@dimen/font_dimen_15"
                        android:text="@string/authentication_idnumber_six"
                        android:textColor="@color/color_F9345D"
                        android:textSize="@dimen/font_sp_12" />
                </LinearLayout>

                <Button
                    android:id="@+id/bt_next"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/font_dimen_45"
                    android:layout_marginLeft="@dimen/font_dimen_15"
                    android:layout_marginTop="@dimen/font_dimen_15"
                    android:layout_marginRight="@dimen/font_dimen_15"
                    android:layout_marginBottom="@dimen/font_dimen_20"
                    android:background="@drawable/btn_selector"
                    android:gravity="center"
                    android:stateListAnimator="@null"
                    android:text="@string/next"
                    android:textColor="@color/white"
                    android:textSize="@dimen/font_sp_14" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
